{
  "expo": {
    "name": "Workplace Messaging",
    "slug": "workplace-messaging",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/company-logo.png",
    "scheme": "workplace-messaging",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/company-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/company-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#095CF2"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Workplace Messaging to use your camera for message attachments.",
          "photosPermission": "Allow Workplace Messaging to access photos for message attachments."
        }
      ],
      "expo-document-picker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
